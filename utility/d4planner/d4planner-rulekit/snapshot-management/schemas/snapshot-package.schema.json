{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "d4-rulekit-snapshot-package/v1"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "entryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "snapshotManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ]
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "schemaVersion",
    "packageVersion",
    "entryId",
    "snapshotId",
    "snapshotManifestSha256",
    "profileSha256",
    "files"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
