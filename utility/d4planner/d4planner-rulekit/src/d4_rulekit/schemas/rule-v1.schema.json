              "enum": [
                "actor",
                "target",
                "skill",
                "summon",
                "event"
              ]
            },
            "math": {
              "type": "string",
              "enum": [
                "add",
                "multiply",
                "set",
                "min",
                "max",
                "cap",
                "floor",
                "override"
              ]
            },
            "value": {
              "$ref": "#/$defs/expr"
            },
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "stage": {
              "type": "string",
              "enum": [
                "base",
                "pre_transform",
                "pre_cast",
                "pre_hit",
                "hit",
                "post_hit",
                "continuous"
              ]
            },
            "snapshot": {
              "type": "string",
              "enum": [
                "cast",
                "hit",
                "tick",
                "dynamic"
              ]
            },
            "priority": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "stat",
            "who",
            "math",
            "value",
            "stage"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "modify_skill"
            },
            "skill": {
              "$ref": "#/$defs/skillselector"
