{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openstream.local/schemas/d4-rule-dsl-v1.schema.json",
  "title": "OpenStream D4 Rule DSL — v1 Candidate Contract",
  "description": "Schema-level syntax/shape check only. Semantic/unit/dependency/patch/physics/calculation correctness require external gates. Do not execute formulas as code.",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "game": {
          "$ref": "#/$defs/patch"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        },
        "mechanics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mechanic"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "required": [
        "schemaVersion",
        "ruleId",
        "game",
        "source",
        "mechanics",
        "verification"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "type": [
                "number",
                "integer",
                "string",
                "boolean"
              ]
            },
            "unit": {
              "type": "string",
              "enum": [
                "none",
                "ratio",
                "percent_point",
                "seconds",
                "milliseconds",
                "damage",
                "life",
                "resource",
                "count",
                "distance",
                "rate_per_second"
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ref"
            },
            "scope": {
              "type": "string",
              "enum": [
                "actor",
                "source",
                "target",
                "skill",
                "item",
                "event",
                "build",
                "scenario",
                "rule",
                "state",
                "summon",
                "enemy",
                "globals"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
            }
          },
          "required": [
            "kind",
            "scope",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "call"
            },
            "fn": {
              "type": "string",
              "enum": [
                "add",
                "subtract",
                "multiply",
                "divide",
                "power",
                "minimum",
                "maximum",
                "clamp",
                "absolute",
                "floor",
                "ceil",
                "round",
                "if",
                "equals",
                "not_equals",
                "greater",
                "greater_equal",
                "less",
                "less_equal",
                "and",
                "or",
                "not",
                "has_tag",
                "contains",
                "count",
                "lookup",
                "coalesce",
                "sum",
                "product"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 1,
              "maxItems": 64
            }
          },
          "required": [
            "kind",
            "fn",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "always",
            "on_event",
            "periodic",
            "on_equip",
            "on_unequip",
            "on_condition_enter",
            "on_condition_exit"
          ]
        },
        "event": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]*$"
        },
        "intervalSeconds": {
          "$ref": "#/$defs/expr"
        },
        "initialDelaySeconds": {
          "$ref": "#/$defs/expr"
        },
        "onSource": {
          "type": "string",
          "enum": [
            "self",
            "owner",
            "summon",
            "ally",
            "enemy",
            "any"
          ]
        },
        "filters": {
          "$ref": "#/$defs/expr"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "proc": {
      "type": "object",
      "properties": {
        "chance": {
          "$ref": "#/$defs/expr"
        },
        "chanceModel": {
          "type": "string",
          "enum": [
            "direct",
            "lucky_hit_scaled",
            "event_weighted",
            "deterministic"
          ]
        },
        "internalCooldownSeconds": {
          "$ref": "#/$defs/expr"
        },
        "oncePerCast": {
          "type": "boolean"
        },
        "oncePerTarget": {
          "type": "boolean"
        },
        "triggeredEventsCanProc": {
          "type": "boolean"
        },
        "maxChainDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "seedPolicy": {
          "type": "string",
          "enum": [
            "deterministic",
            "simulation_rng"
          ]
        }
      },
      "required": [
        "chanceModel",
        "triggeredEventsCanProc",
        "maxChainDepth"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string",
          "enum": [
            "self",
            "source",
            "target",
            "all_enemies",
            "enemies_in_area",
            "nearest_enemies",
            "all_allies",
            "summons",
            "random_enemy",
            "ground_location"
          ]
        },
        "limit": {
          "$ref": "#/$defs/expr"
        },
        "radius": {
          "$ref": "#/$defs/expr"
        },
        "shape": {
          "type": "string",
          "enum": [
            "single",
            "circle",
            "cone",
            "line",
            "chain",
            "projectile_path",
            "aura",
            "global"
          ]
        },
        "maxDistance": {
          "$ref": "#/$defs/expr"
        },
        "sort": {
          "type": "string",
          "enum": [
            "nearest",
            "farthest",
            "random",
            "lowest_health",
            "highest_health"
          ]
        },
        "lineOfSight": {
          "type": "boolean"
        }
      },
      "required": [
        "selector"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "stateId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]*$"
        },
        "durationSeconds": {
          "$ref": "#/$defs/expr"
        },
        "stacks": {
          "$ref": "#/$defs/expr"
        },
        "maxStacks": {
          "$ref": "#/$defs/expr"
        },
        "stacking": {
          "type": "string",
          "enum": [
            "refresh",
            "replace",
            "independent",
            "add",
            "highest_wins",
            "lowest_wins",
            "ignore"
          ]
        },
        "expiration": {
          "type": "string",
          "enum": [
            "each_stack",
            "all_at_once",
            "permanent"
          ]
        },
        "dispelGroup": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "stateId",
        "stacking",
        "expiration"
      ],
      "additionalProperties": false
    },
    "skillselector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "id"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]*$"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "event_skill"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "expr"
            },
            "value": {
              "$ref": "#/$defs/expr"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "modify_stat"
