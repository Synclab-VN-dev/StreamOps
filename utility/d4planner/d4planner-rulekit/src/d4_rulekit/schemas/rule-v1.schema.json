            "property": {
              "type": "string",
              "enum": [
                "coefficient",
                "rank",
                "cast_time",
                "animation_frames",
                "cooldown",
                "charges",
                "resource_cost",
                "projectile_count",
                "projectile_speed",
                "projectile_pierce",
                "ricochet_count",
                "hits_per_target",
                "area_radius",
                "area_shape",
                "duration",
                "tick_interval",
                "target_limit",
                "summon_count",
                "summon_attack_speed",
                "lucky_hit_coefficient"
              ]
            },
            "math": {
              "type": "string",
              "enum": [
                "add",
                "multiply",
                "set",
                "min",
                "max",
                "override"
              ]
            },
            "value": {
              "$ref": "#/$defs/expr"
            },
            "stage": {
              "type": "string",
              "enum": [
                "pre_transform",
                "pre_cast",
                "cast",
                "hit",
                "tick"
              ]
            },
            "priority": {
              "type": "integer"
            }
          },
          "required": [
            "op",
            "skill",
            "property",
            "math",
            "value",
            "stage"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "transform_tags"
            },
            "skill": {
              "$ref": "#/$defs/skillselector"
