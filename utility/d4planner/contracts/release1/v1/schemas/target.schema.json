{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamops.local/schemas/d4planner-target/v1",
  "title": "D4Planner Release 1 target envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetId", "displayName", "canonicalBuild", "assessmentPolicy"],
  "properties": {
    "schemaVersion": { "const": "d4planner-target/v1" },
    "targetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "canonicalBuild": { "$ref": "https://streamops.local/schemas/d4-build/v1" },
    "preservedSections": {
      "type": "object",
      "description": "Opaque source sections retained for round-trip/provenance only; never Release 1 scoring input.",
      "additionalProperties": false,
      "properties": {
        "charms": {},
        "sourceMetadata": {}
      }
    },
    "assessmentPolicy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "weightProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "approval", "coreWeight", "nonCoreWeight"],
      "properties": {
        "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
        "approval": { "enum": ["APPROVED", "TEST_ONLY"] },
        "coreWeight": { "type": "number", "exclusiveMinimum": 0 },
        "nonCoreWeight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "slotId", "kind", "entityId", "core", "weightClass", "comparator", "unit", "expected", "evidenceRequirement"],
      "properties": {
        "criterionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
        "slotId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["AFFIX", "EFFECT"] },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "core": { "type": "boolean" },
        "weightClass": { "enum": ["CORE", "NON_CORE"] },
        "comparator": { "enum": ["AT_LEAST", "AT_MOST", "EQUAL", "BETWEEN", "PRESENT"] },
        "unit": { "enum": ["PERCENT", "FLAT", "RANK", "SECONDS", "NONE"] },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "type": ["number", "string", "boolean"] },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" }
          },
          "minProperties": 0
        },
        "evidenceRequirement": { "enum": ["PRESENT_VALUE", "COMPLETE_CATEGORY", "COMPLETE_SLOT"] }
      },
      "allOf": [
        { "if": { "properties": { "core": { "const": true } }, "required": ["core"] }, "then": { "properties": { "weightClass": { "const": "CORE" } } } },
        { "if": { "properties": { "core": { "const": false } }, "required": ["core"] }, "then": { "properties": { "weightClass": { "const": "NON_CORE" } } } },
        { "if": { "properties": { "comparator": { "const": "BETWEEN" } }, "required": ["comparator"] }, "then": { "properties": { "expected": { "required": ["minimum", "maximum"] } } } },
        { "if": { "properties": { "comparator": { "enum": ["AT_LEAST", "AT_MOST", "EQUAL"] } }, "required": ["comparator"] }, "then": { "properties": { "expected": { "required": ["value"] } } } },
        { "if": { "properties": { "comparator": { "const": "PRESENT" } }, "required": ["comparator"] }, "then": { "properties": { "expected": { "maxProperties": 0 }, "unit": { "const": "NONE" } } } }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "scope", "weightProfile", "criteria"],
      "properties": {
        "version": { "const": "d4planner-equipment-policy/v1" },
        "scope": { "const": "EQUIPMENT_ONLY" },
        "weightProfile": { "$ref": "#/$defs/weightProfile" },
        "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } }
      }
    }
  }
}
