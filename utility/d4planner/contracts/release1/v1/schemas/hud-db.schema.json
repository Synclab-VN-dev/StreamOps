{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamops.local/schemas/d4planner-hud-db/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dbId",
    "epoch",
    "hudRevision",
    "hud"
  ],
  "properties": {
    "schemaVersion": {
      "const": "d4planner-hud-db/v1"
    },
    "dbId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "hudRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hud": {
      "$ref": "https://streamops.local/schemas/d4planner-hud/v1"
    }
  }
}
