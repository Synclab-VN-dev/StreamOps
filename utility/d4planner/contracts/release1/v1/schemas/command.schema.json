{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamops.local/schemas/d4planner-control/v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "targetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "displayName",
        "contentSha256",
        "byteLength",
        "validation",
        "errorCodes"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/targetId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "validation": {
          "enum": [
            "VALID",
            "INVALID"
          ]
        },
        "errorCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "requestId",
        "ownerInstanceId",
        "childInstanceId",
        "generation",
        "type",
        "method",
        "params"
      ],
      "properties": {
        "protocolVersion": {
          "const": "d4planner-control/v1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ownerInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "childInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "request"
        },
        "method": {
          "enum": [
            "target.list",
            "target.select"
          ]
        },
        "params": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "target.list"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          },
          "else": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "targetId",
                  "expectedSha256",
                  "expectedListRevision"
                ],
                "properties": {
                  "targetId": {
                    "$ref": "#/$defs/targetId"
                  },
                  "expectedSha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "expectedListRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "requestId",
        "ownerInstanceId",
        "childInstanceId",
        "generation",
        "type",
        "result",
        "error"
      ],
      "properties": {
        "protocolVersion": {
          "const": "d4planner-control/v1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ownerInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "childInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "response"
        },
        "result": {
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    }
  }
}
