{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamops.local/schemas/d4planner-notify/v1",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/hello.accepted"
    },
    {
      "$ref": "#/$defs/hud.committed"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "messageId",
        "credential",
        "origin"
      ],
      "properties": {
        "protocolVersion": {
          "const": "d4planner-notify/v1"
        },
        "type": {
          "const": "hello"
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "credential": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "hello.accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "messageId",
        "correlationId"
      ],
      "properties": {
        "protocolVersion": {
          "const": "d4planner-notify/v1"
        },
        "type": {
          "const": "hello.accepted"
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "hud.committed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "messageId",
        "dbId",
        "epoch",
        "hudRevision"
      ],
      "properties": {
        "protocolVersion": {
          "const": "d4planner-notify/v1"
        },
        "type": {
          "const": "hud.committed"
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "dbId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "hudRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "messageId",
        "code"
      ],
      "properties": {
        "protocolVersion": {
          "const": "d4planner-notify/v1"
        },
        "type": {
          "const": "error"
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    }
  }
}
