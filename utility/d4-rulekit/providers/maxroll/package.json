{
  "name": "@streamops/maxroll-calculation-provider",
  "version": "0.1.0",
  "private": true,
  "description": "Version-pinned Maxroll calculation provider for D4 Rule Kit",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "engines": { "node": ">=20" },
  "scripts": {
    "test:unit": "node scripts/run-suite.js unit",
    "test:contract": "node scripts/run-suite.js contract",
    "test:e2e": "node scripts/run-suite.js e2e",
    "test:adapter-real": "node scripts/run-suite.js adapter-real",
    "test:real": "node scripts/run-suite.js real",
    "e2e:real:offline": "node scripts/offline-real-e2e.js",
    "snapshot:capture": "node scripts/snapshot-capture.js",
    "fixture:encrypted": "node scripts/encrypted-fixture.js",
    "e2e:real:live-capture": "node scripts/live-capture-real-e2e.js",
    "smoke:browser": "node scripts/browser-smoke.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && npm run test:unit && npm run test:contract && npm run test:e2e"
  },
  "dependencies": {
    "@streamops/browser-infrastructure": "file:../../browser-infra",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
